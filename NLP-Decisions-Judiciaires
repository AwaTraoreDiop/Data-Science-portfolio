        "\n",
        "# Tokenisation\n",
        "print('Chargement du tokenizer CamemBERT...')\n",
        "tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)\n",
        "\n",
        "def tokenize(batch):\n",
        "    return tokenizer(\n",
        "        batch['text'],\n",
        "        truncation=True,\n",
        "        padding='max_length',\n",
        "        max_length=256  # decisions plus longues qu'Allocine -> 256 tokens\n",
